// src_vit/codegen/llvm_emitter.vit - LLVM IR Code Generation for Vit Compiler

import { ASTNode } from "src_vit/parser/ast.vit";

struct LLVMEmitter {
    output: string,

    function init(): void {
        this.output = "";
    },

    function emitHeader(): void {
        this.output = "; ModuleID = 'vit_self_hosted'\n";
        this.output = this.output + "declare i32 @puts(i8*)\n";
        this.output = this.output + "declare i32 @printf(i8*, ...)\n\n";
    },

    function emitMain(): void {
        this.output = this.output + "define i32 @main(i32 %argc, i8** %argv) {\n";
        this.output = this.output + "entry:\n";
        this.output = this.output + "  ret i32 0\n";
        this.output = this.output + "}\n";
    },

    function getCode(): string {
        return this.output;
    }
}

function createLLVMEmitter(): LLVMEmitter {
    let e: LLVMEmitter;
    e.output = "";
    return e;
}
