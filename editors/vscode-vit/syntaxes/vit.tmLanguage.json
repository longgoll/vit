{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vit",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#vito_framework" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.vit",
          "match": "//.*$"
        },
        {
          "name": "comment.block.vit",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vit",
          "match": "\\b(if|else|for|while|return|break|continue|async|await|try|catch)\\b"
        },
        {
          "name": "keyword.other.vit",
          "match": "\\b(function|fn|let|const|var|struct|class|type|interface|import|export|from|module)\\b"
        },
        {
          "name": "constant.language.vit",
          "match": "\\b(true|false|null|undefined|nil)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.vit",
          "match": "\\b(number|string|boolean|void|any|Array|Map|Set|Promise|Response|Request|VitoApp|Context)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.vit",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.vit",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.vit",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.vit",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.vit",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.vit",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\("
        }
      ]
    },
    "vito_framework": {
      "patterns": [
        {
          "name": "keyword.operator.vito.route",
          "match": "\\.(get|post|put|delete|patch|use|listen)\\b"
        }
      ]
    }
  },
  "scopeName": "source.vit"
}
