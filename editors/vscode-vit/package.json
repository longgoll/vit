{
  "name": "vscode-vit",
  "displayName": "Vit & Vito Language Support",
  "description": "Next-Gen IDE experience: Intellisense, CodeLens 1-Click Run, Doc Comments Hover, Signature Help, Inlay Hints, Rename Symbol, Formatting & LSP",
  "version": "2.4.0",
  "publisher": "HongLong",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "*"
  ],
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "vit",
        "aliases": [
          "Vit",
          "vit"
        ],
        "extensions": [
          ".vit"
        ],
        "icon": {
          "light": "./icon.svg",
          "dark": "./icon.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vit",
        "scopeName": "source.vit",
        "path": "./syntaxes/vit.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "vit",
        "path": "./snippets/vito.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "vit.runFile",
        "title": "Vit: Run Active Vit File"
      },
      {
        "command": "vit.restartLsp",
        "title": "Vit: Restart Language Server (LSP)"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Vit & Vito Configuration",
      "properties": {
        "vit.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Custom path to vit-lsp.exe executable."
        },
        "vit.format.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic document formatting for .vit files."
        },
        "vit.inlayHints.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable inlay hints for variable types and parameters."
        },
        "vit.codeLens.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable 1-Click Run CodeLens above function main()."
        }
      }
    }
  }
}
