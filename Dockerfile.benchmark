# VIT Runtime Benchmark Dockerfile
# VRI-11: Use debian:bookworm-slim (matches TFB environment) instead of ubuntu:24.04
# RI-06: -march=x86-64-v3 instead of -march=native
# VRI-05: -std=c11 for _Thread_local support
# VRI-12: Include concurrency_rt_posix.c (Linux pthread implementation)

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    gcc \
    g++ \
    clang \
    curl \
    git \
    liburing-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . /app

RUN gcc -O3 -march=x86-64-v3 -flto -std=c11 \
    -Iinclude -Isrc/runtime \
    test/Phase15/benchmark_server.c \
    src/runtime/memory_rt.c \
    src/runtime/async_iouring_rt.c \
    src/runtime/http_parser_simd.c \
    src/runtime/net_rt.c \
    src/runtime/concurrency_rt_posix.c \
    src/runtime/slab_allocator_rt.c \
    -pthread -luring -o benchmark_server

EXPOSE 8080

CMD ["/app/benchmark_server"]
