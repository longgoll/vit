// VIT Standard Library: String Utilities Module (std/string.vit)

extern function strlen(str: string): number;
extern function __vit_str_char_at(str: string, index: number): string;
extern function __vit_str_index_of(str: string, sub: string): number;
extern function __vit_str_substring(str: string, start: number, length: number): string;
extern function __vit_str_starts_with(str: string, prefix: string): number;
extern function __vit_str_ends_with(str: string, suffix: string): number;
extern function __vit_str_trim(str: string): string;
extern function __vit_str_replace(str: string, target: string, replacement: string): string;
extern function __vit_str_regex_match(str: string, pattern: string): number;

// RI-11/VRI-09: VIT strings are UTF-8 encoded C char* (NOT UTF-16).
// strlen() returns byte count, which equals UTF-8 byte length.
// This is CORRECT for HTTP Content-Length (RFC 7230: byte count, not char count).
// byteLength() is an explicit alias to document this intent.
function length(str: string): number {
    return strlen(str);  // byte count = UTF-8 byte length ✓
}

function byteLength(str: string): number {
    return strlen(str);  // explicit: byte count for HTTP Content-Length
}

function charAt(str: string, index: number): string {
    return __vit_str_char_at(str, index);
}

function indexOf(str: string, sub: string): number {
    return __vit_str_index_of(str, sub);
}

function substring(str: string, start: number, length: number): string {
    return __vit_str_substring(str, start, length);
}

function startsWith(str: string, prefix: string): boolean {
    let res = __vit_str_starts_with(str, prefix);
    return res > 0;
}

function endsWith(str: string, suffix: string): boolean {
    let res = __vit_str_ends_with(str, suffix);
    return res > 0;
}

function trim(str: string): string {
    return __vit_str_trim(str);
}

function replace(str: string, target: string, replacement: string): string {
    return __vit_str_replace(str, target, replacement);
}

function regexMatch(str: string, pattern: string): boolean {
    let res = __vit_str_regex_match(str, pattern);
    return res > 0.0;
}
