// Standard Library Module for String Utilities in VIT Compiler
// C Runtime String Interop Declarations

extern function __vit_char_at(str: string, index: number): string;
extern function __vit_strlen(str: string): number;

function charAt(str: string, index: number): string {
    return __vit_char_at(str, index);
}

function stringLength(str: string): number {
    return __vit_strlen(str);
}
