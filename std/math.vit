// VIT Standard Library: Math Module (std/math.vit)

extern function sqrt(x: number): number;
extern function cos(x: number): number;
extern function sin(x: number): number;
extern function tan(x: number): number;
extern function abs(x: number): number;
extern function pow(x: number, y: number): number;
extern function floor(x: number): number;
extern function ceil(x: number): number;
extern function round(x: number): number;
extern function log(x: number): number;
extern function exp(x: number): number;
extern function __vit_math_random(): number;

function min(a: number, b: number): number {
    if (a < b) { return a; }
    return b;
}

function max(a: number, b: number): number {
    if (a > b) { return a; }
    return b;
}

function clamp(val: number, minVal: number, maxVal: number): number {
    if (val < minVal) { return minVal; }
    if (val > maxVal) { return maxVal; }
    return val;
}

function random(): number {
    return __vit_math_random();
}
