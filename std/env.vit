// std/env.vit - Standard Environment & CLI Arguments Module for Vit

extern function __vit_get_arg_count(): number;
extern function __vit_get_arg(index: number): string;
extern function __vit_get_env(name: string): string;

function getArgCount(): number {
    return __vit_get_arg_count();
}

function getArg(index: number): string {
    return __vit_get_arg(index);
}

function getEnv(name: string): string? {
    let val = __vit_get_env(name);
    if (val == "") {
        return null;
    }
    return val;
}
