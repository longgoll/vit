// VIT Standard Library: System & Time Utilities Module (std/sys.vit)

extern function clock(): number;
extern function exit(code: number): void;
extern function system(cmd: string): number;

function getTimestampMs(): number {
    return clock();
}

function sleepMs(ms: number): void {
    let start = clock();
    while ((clock() - start) < ms) {
        // busy wait fallback
    }
}
